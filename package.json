{
  "name": "zeitwerk",
  "version": "1.0.0",
  "description": "Lokale Arbeitszeiterfassung mit Pausenüberwachung nach deutschem Arbeitszeitgesetz, 40-15-5-Bewegungserinnerungen und Projektzeitbuchung.",
  "author": "Zeitwerk",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "smoke": "electron-vite build && xvfb-run -a electron scripts/smoke.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@fluentui/react-charts": "^9.3.22",
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-datepicker-compat": "^0.6.34",
    "@fluentui/react-icons": "^2.0.334",
    "@fluentui/react-timepicker-compat": "^0.4.36",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
